# Root level .dockerignore for multi-service builds

# Version Control
.git/
.gitignore
.gitattributes

# Documentation
*.md
docs/
*.rst
LICENSE


# CI/CD
.github/
.gitlab-ci.yml
*.yml

# Environment files
.env*
!.env.example

# IDE and Editor files
.vscode/
.idea/
*.swp
*.swo
*~

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Terraform
Terraform/
*.tfstate*
*.tfvars
!example.tfvars
*.tfplan
*.pem
*.key
*.crt

# Scripts
scripts/
deploy*.sh
deploy*.bat

# Docker
docker-compose*.yml
Dockerfile.dev
.dockerignore

# Logs
logs/
*.log

# Temporary files
tmp/
temp/
*.tmp
*.bak
*.backup
*.orig

# Test files
**/tests/
**/*test*
**/coverage/
**/.coverage
**/.pytest_cache/

# Build artifacts
**/build/
**/dist/
**/target/

# Dependencies (will be installed in container)
**/node_modules/
**/__pycache__/
**/venv/
**/.venv/

# Static files (will be collected in container)
**/staticfiles/
**/static/
**/media/